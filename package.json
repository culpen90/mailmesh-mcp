{
  "name": "mailmesh-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A single-user Cloudflare Workers MCP server that unifies multiple email accounts.",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm test && npm run build",
    "cf-typegen": "wrangler types",
    "db:local": "wrangler d1 migrations apply mailmesh --local",
    "db:remote": "wrangler d1 migrations apply mailmesh --remote",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --local",
    "oauth-smoke": "node scripts/oauth-smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types --check && tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.8.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.17.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "engines": {
    "node": ">=20"
  }
}
